{
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "npm:preact@10.25.4",
    "lib": ["deno.window", "dom", "dom.iterable"]
  },
  "nodeModulesDir": "auto",
  "unstable": ["bundle"],
  "imports": {
    "preact": "npm:preact@10.25.4",
    "preact/hooks": "npm:preact@10.25.4/hooks",
    "preact/jsx-runtime": "npm:preact@10.25.4/jsx-runtime",
    "@preact/signals": "npm:@preact/signals@2.0.1",
    "htm": "npm:htm@^3.1.1",
    "htm/preact": "npm:htm@^3.1.1/preact",
    "idb-keyval": "npm:idb-keyval@^6.2.1",
    "mdast-util-from-markdown": "npm:mdast-util-from-markdown@^2.0.2",
    "mdast-util-gfm": "npm:mdast-util-gfm@^3.1.0",
    "micromark-extension-gfm": "npm:micromark-extension-gfm@^3.0.0",
    "@std/assert": "jsr:@std/assert@^1.0.11",
    "@std/testing": "jsr:@std/testing@^1.0.3",
    "@std/http": "jsr:@std/http@^1.1.3",
    "@std/http/file-server": "jsr:@std/http@^1.1.3/file-server"
  },
  "tasks": {
    "dev": "deno run -A --unstable-bundle dev.ts",
    "build": "deno run -A --unstable-bundle build.ts",
    "serve": "deno run -A server.ts",
    "check": "deno check --unstable-bundle dev.ts build.ts server.ts src/sw.ts src/main.js src/lib/md-transpiler.ts tests/*.ts",
    "test": "deno test -A --unstable-bundle tests/"
  }
}
