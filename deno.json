{
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "https://esm.sh/preact@10.25.4",
    "lib": ["deno.window", "dom", "dom.iterable"]
  },
  "imports": {
    "@std/http": "jsr:@std/http@^1.1.3",
    "@std/http/file-server": "jsr:@std/http@^1.1.3/file-server"
  },
  "tasks": {
    "dev": "deno run -A dev.ts",
    "build": "deno run -A build.ts",
    "serve": "deno run -A server.ts",
    "check": "deno check dev.ts build.ts server.ts"
  }
}
